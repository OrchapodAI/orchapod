FROM python:3.12-slim
WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi>=0.115 \
    "uvicorn[standard]>=0.30" \
    "sqlmodel>=0.0.21" \
    "sqlalchemy[asyncio]>=2.0" \
    "asyncpg>=0.29" \
    "pydantic>=2.7" \
    "boto3>=1.34" \
    "runpod>=1.7"

# packages/ must be on the path so providers + workflow-schema are importable
COPY packages /app/packages

# api/ is volume-mounted for hot reload — only copy for production builds
# COPY apps/api /app/api

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
