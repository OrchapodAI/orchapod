# Caddy for infra/docker-compose.prod.yml. Automatic HTTPS (Let's Encrypt) for both names once their A records point here.
# reverse_proxy passes WebSockets (/ws/runs/{id}) through as they are, and flushes SSE (text/event-stream) at once.
# It also replaces any X-Forwarded-For a client sends, so the API (which trusts it, apps/api/Dockerfile) sees the real IP.
# Never add `trusted_proxies` here or put a CDN in front: the API trusts X-Forwarded-For from any peer, so either would let a
# client choose its own rate-limit bucket.
# The file is bind-mounted on its own: after editing it, `dc restart caddy` (docs/HOSTING.md "Deploy").

app.{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy web:3000
}

api.{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 1MB  # no API request is bigger; a larger body never reaches the single worker
	}
	reverse_proxy api:8000
}
