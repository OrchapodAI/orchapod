# Copy this to .env and fill in your values
# Never commit .env to git
#
# ═══════════════════════════════════════════════════════════════════
# NEBIUS x NVIDIA HACKATHON — quick start
# ═══════════════════════════════════════════════════════════════════
# Minimum set for hackathon demo:
#   NEBIUS_API_KEY     — Token Factory (Nemotron inference)
#   NEBIUS_IAM_TOKEN   — AI Cloud compute (GPU jobs)
#   NEBIUS_FOLDER_ID   — your Nebius project folder
#   DATABASE_URL       — local Postgres (see README)
# Everything else can be left as placeholder for UI-only testing.
# ═══════════════════════════════════════════════════════════════════

# ---------------------------------------------------------------------------
# Nebius AI Cloud — compute (GPU instances for training/serving)
# Console: https://console.nebius.ai
# Docs:    https://nebius.com/docs/iam/operations/iam-token/create-iam-token
# ---------------------------------------------------------------------------
NEBIUS_IAM_TOKEN=your_nebius_iam_token_here
NEBIUS_FOLDER_ID=your_nebius_folder_id_here
NEBIUS_SUBNET_ID=your_nebius_subnet_id_here   # from Nebius VPC console

# ---------------------------------------------------------------------------
# Nebius Token Factory — NVIDIA Nemotron inference (OpenAI-compatible)
# Get your key at: https://studio.nebius.ai → API Keys
# Models: Nemotron Ultra, Super, 70B, Mini — all OpenAI-compat
# Used for: LLM-as-judge in lm-eval, direct Nemotron inference
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=your_nebius_token_factory_key_here

# Judge model for lm-eval (default: Nemotron Ultra)
# Options: nvidia/Llama-3.1-Nemotron-Ultra-253B-v1 (best quality)
#          nvidia/Llama-3.3-Nemotron-Super-49B-v1  (faster, cheaper)
JUDGE_MODEL=nvidia/Llama-3.1-Nemotron-Ultra-253B-v1

# ---------------------------------------------------------------------------
# GPU Provider — Vast.ai (optional; Nebius preferred for hackathon)
# Get your key at: https://vast.ai/account
# ---------------------------------------------------------------------------
VASTAI_API_KEY=your_vastai_api_key_here

# ---------------------------------------------------------------------------
# Anthropic (required for lm-eval Claude-as-judge; optional for quantize+serve)
# Get at: https://console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# HuggingFace (optional — only needed for private/gated models)
# Get at: https://huggingface.co/settings/tokens
# ---------------------------------------------------------------------------
HF_TOKEN=hf_...

# ---------------------------------------------------------------------------
# Database — PostgreSQL (required)
# Local: docker run -e POSTGRES_PASSWORD=orchapod -p 5432:5432 postgres:16
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:orchapod@localhost:5432/orchapod

# ---------------------------------------------------------------------------
# Cloudflare R2 — artifact storage (required)
# Dashboard: https://dash.cloudflare.com → R2 → Create bucket + API token
# ---------------------------------------------------------------------------
ORCHAPOD_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
ORCHAPOD_R2_ACCESS_KEY=your_r2_access_key
ORCHAPOD_R2_SECRET_KEY=your_r2_secret_key
ORCHAPOD_R2_BUCKET=orchapod-artifacts

# ---------------------------------------------------------------------------
# Control plane public URL (required)
# Must be reachable from Vast.ai pod IPs — i.e. public internet.
# Local dev: run `ngrok http 8000` and paste the https URL here.
# ---------------------------------------------------------------------------
ORCHAPOD_CONTROL_URL=https://your-ngrok-or-domain.here

# ---------------------------------------------------------------------------
# Auth (future — not enforced yet)
# ---------------------------------------------------------------------------
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# ---------------------------------------------------------------------------
# Cloudflare Tunnel — stable HTTPS endpoints for vllm-serve pods (KAN-28)
#
# OPTION A — Quick Tunnel (no account, free *.trycloudflare.com URLs):
#   Leave CLOUDFLARE_TUNNEL_TOKEN unset. cloudflared is automatically
#   installed in the vllm-serve container and a temporary URL is created.
#
# OPTION B — Named Tunnel (recommended for production):
#   1. Create a tunnel: cloudflared tunnel create orchapod
#   2. Set a CNAME: *.endpoints.orchapod.dev → <tunnel-id>.cfargotunnel.com
#   3. Paste the tunnel token below (from `cloudflared tunnel token <name>`)
#   Each run_id becomes: https://{run_id}.endpoints.orchapod.dev
# ---------------------------------------------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiO...

# ---------------------------------------------------------------------------
# Email — endpoint expiry warnings (KAN-30)
# Powered by Resend (https://resend.com). Free tier: 3,000 emails/month.
#   1. Sign up at resend.com, verify your domain.
#   2. Create an API key (Sending Access).
#   3. Set ORCHAPOD_FROM_EMAIL to a verified sender on your domain.
#   4. Set ORCHAPOD_ALERT_EMAIL to where you want alerts delivered.
# If RESEND_API_KEY is unset, email sending is silently skipped (safe for dev).
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
ORCHAPOD_FROM_EMAIL=noreply@yourdomain.com
ORCHAPOD_ALERT_EMAIL=you@yourdomain.com

# ---------------------------------------------------------------------------
# GitHub (for container image registry)
# ---------------------------------------------------------------------------
GITHUB_ORG=orchapod
