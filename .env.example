# Copy this to .env and fill in your values
# Never commit .env to git

# --- GPU Providers ---
RUNPOD_API_KEY=your_runpod_api_key_here
VASTAI_API_KEY=your_vastai_api_key_here

# --- AI / Model APIs ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here   # for agent layer + LLM-as-judge
HF_TOKEN=your_huggingface_token_here            # for downloading gated models

# --- Auth ---
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# --- Database ---
DATABASE_URL=postgresql+asyncpg://orchapod:orchapod_dev@localhost:5432/orchapod

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Cloudflare R2 (or MinIO for local dev) ---
ORCHAPOD_R2_ENDPOINT=http://localhost:9000     # use https://...r2.cloudflarestorage.com in prod
ORCHAPOD_R2_ACCESS_KEY=orchapod
ORCHAPOD_R2_SECRET_KEY=orchapod_dev
ORCHAPOD_R2_BUCKET=orchapod-artifacts

# --- Control plane ---
ORCHAPOD_CONTROL_URL=http://localhost:8000     # change to prod URL in production

# --- GitHub (for container registry) ---
GITHUB_ORG=orchapod
