# Orchapod environment: copy to .env and fill in the blanks. Never commit .env.
# Every variable from docs/contracts.md "Config", with its default and where to get it. Blank = none.
# The executor forwards only the node-facing ones to containers.
# Hosted: the VM's /opt/orchapod/.env takes the "hosted:" values below plus the last section (docs/HOSTING.md lists them);
# infra/docker-compose.prod.yml sets DATABASE_URL, REDIS_URL and ORCHAPOD_CONTROL_URL itself.

# --- Nebius Token Factory: Nemotron inference and fine-tuning ---
# https://tokenfactory.nebius.com -> API keys
NEBIUS_API_KEY=
# The key is only ever sent to this URL.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# --- Tavily: the web-research node ---
# https://app.tavily.com -> API keys (free tier 1,000 credits/month; +$25 via the Nebius Builders Program)
TAVILY_API_KEY=

# --- Nebius AI Cloud: Serverless Jobs (gpu nodes) and Endpoints (vllm-serve) ---
# https://console.nebius.com -> your project's id (project-...); gpu nodes need it
NEBIUS_PROJECT_ID=
# Optional: `nebius iam get-access-token`; when blank the client runs that CLI itself.
# hosted: blank; the api image has the CLI, with a service-account profile from /opt/orchapod/nebius (R15)
NEBIUS_IAM_TOKEN=
# The one bearer token of our Serverless Endpoints: `openssl rand -hex 32`
ORCHAPOD_ENDPOINT_TOKEN=

# --- Object storage (S3 API). Defaults = the compose MinIO (`make up`). ---
# hosted (required): ORCHAPOD_R2_ENDPOINT=https://storage.eu-north1.nebius.cloud, ORCHAPOD_R2_REGION=eu-north1, the static
# access key of a service account with storage access (console -> Object Storage), and a bucket that allows GET from * (R21).
ORCHAPOD_R2_ENDPOINT=http://localhost:9000
ORCHAPOD_R2_REGION=auto
ORCHAPOD_R2_ACCESS_KEY=orchapod
ORCHAPOD_R2_SECRET_KEY=orchapod_dev
ORCHAPOD_R2_BUCKET=orchapod-artifacts

# --- Node images: ${ORCHAPOD_IMAGE_PREFIX}/<node-type>:latest, where CI pushes; a local orchapod/<node-type>:dev wins ---
ORCHAPOD_IMAGE_PREFIX=ghcr.io/bangadpurva

# --- Control plane ---
# Matches infra/docker-compose.dev.yml; unset = sqlite+aiosqlite:///./orchapod_dev.db
DATABASE_URL=postgresql+asyncpg://orchapod:orchapod_dev@localhost:5432/orchapod
REDIS_URL=redis://localhost:6379
# Where containers reach the API; a public https URL whenever gpu nodes run (remote nodes log through it)
ORCHAPOD_CONTROL_URL=http://localhost:8001
# Guards /internal/*; blank = a random value per API start. Set one (`openssl rand -hex 32`) for more than one worker.
# hosted (required, R17): `openssl rand -hex 32`
ORCHAPOD_INTERNAL_SECRET=

# --- Budget guard, in $ (contracts "Budget guard"). The executor derives each node's ORCHAPOD_MAX_COST_USD from these. ---
ORCHAPOD_MAX_RUN_USD=3
# Per UTC day: every run, plus the planner, the reporter and /compare. hosted: Hari's decision 5 (the proposal says 5)
ORCHAPOD_MAX_DAY_USD=15
# 1 = refuse every plan, run, start and retry (hosted: docs/HOSTING.md "Kill switch")
ORCHAPOD_KILL_SWITCH=0
# Caps are multiplied by this for callers without the admin header. hosted: Hari's decision 5 (the proposal says 0.1)
ORCHAPOD_ANON_SCALE=0.1
# Callers sending X-Orchapod-Admin: <this> get the full caps; blank = everyone is anonymous. `openssl rand -hex 32`
ORCHAPOD_ADMIN_TOKEN=
# Executor backstop per node, in seconds
ORCHAPOD_NODE_TIMEOUT_S=5400
# /compare streams in flight at once; one more gets 503
ORCHAPOD_MAX_COMPARES=4

# --- Nodes ---
# 1 = deterministic stub outputs and no paid calls (make check); blank for real runs
STUB=
# Gated Hugging Face models: https://huggingface.co/settings/tokens (read)
HF_TOKEN=

# --- Optional ---
# Endpoint-expiry emails: https://resend.com/api-keys (blank = no email)
RESEND_API_KEY=
ORCHAPOD_FROM_EMAIL=noreply@orchapod.ai
ORCHAPOD_ALERT_EMAIL=
# vast.ai, spikes only: https://cloud.vast.ai/account. Commented out on purpose: once it is set, the API registers vast.ai
# and any gpu node whose provider_pref names vastai rents a vast.ai GPU on this key. Never on the hosted VM.
# VASTAI_API_KEY=

# --- Hosted only (docs/HOSTING.md); unused locally ---
# Caddy serves app.<DOMAIN> (web) and api.<DOMAIN> (the API; ORCHAPOD_CONTROL_URL becomes https://api.<DOMAIN>)
DOMAIN=
# The hosted Postgres password, hex so it fits in DATABASE_URL: `openssl rand -hex 32`
POSTGRES_PASSWORD=
# scripts/deploy-hosted.sh reads ORCHAPOD_DEPLOY_HOST=<user>@<vm> from your shell, not from this file.
