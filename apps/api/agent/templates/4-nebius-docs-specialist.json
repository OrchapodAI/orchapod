{
  "slug": "nebius-docs-specialist",
  "title": "Nemotron Nano 8B tuned as a Nebius docs specialist",
  "intent": "Distill a Nebius docs specialist: fine-tune NVIDIA Nemotron Nano 8B on the Nebius AI Cloud and Token Factory docs",
  "rationale": "Tavily extracts 20 Nebius docs pages (Token Factory fine-tuning, models, Dedicated-endpoint deploy and billing; AI Cloud Serverless jobs and endpoints, Compute and Object Storage prices, Object Storage, quotas), Nemotron 3 Super writes short Q&A grounded in them, and Unsloth trains NVIDIA's open Nemotron Nano 8B with a 16-bit LoRA on an H100 Serverless Job (spike 4's recipe: 60 steps, about two epochs). vllm-serve hosts the student and its adapter side by side on one L40S endpoint for 25 minutes (R14), so base and tuned answer from one serving stack with identical decoding, and Nemotron 3 Ultra then judges base against tuned on held-out questions with the source passage as reference, so every answer can be checked against the docs. It rents GPUs (under the $3 run cap, R14), so on the public app only the admin runs it.",
  "plan": {
    "name": "nebius-docs-specialist-nemotron-nano-8b",
    "nodes": [
      {"id": "research", "type": "web-research", "needs": [], "inputs": {
        "seed_urls": ["https://docs.tokenfactory.nebius.com/post-training/how-to-fine-tune",
                      "https://docs.tokenfactory.nebius.com/post-training/models",
                      "https://docs.nebius.com/serverless/overview",
                      "https://docs.nebius.com/serverless/tutorials/deploy-model",
                      "https://docs.nebius.com/serverless/quickstart/jobs",
                      "https://docs.nebius.com/serverless/pricing-quotas",
                      "https://docs.tokenfactory.nebius.com/post-training/datasets",
                      "https://docs.tokenfactory.nebius.com/ai-models-inference/dedicated-endpoints/custom-weights",
                      "https://docs.tokenfactory.nebius.com/ai-models-inference/dedicated-endpoints/deploy-api",
                      "https://docs.tokenfactory.nebius.com/ai-models-inference/overview",
                      "https://docs.tokenfactory.nebius.com/ai-models-inference/rate-limits",
                      "https://docs.tokenfactory.nebius.com/other-capabilities/billing-new",
                      "https://docs.nebius.com/compute/resources/pricing",
                      "https://docs.nebius.com/object-storage/resources/pricing",
                      "https://docs.nebius.com/serverless/tutorials/fine-tuning",
                      "https://docs.nebius.com/object-storage/overview",
                      "https://docs.nebius.com/object-storage/quickstart",
                      "https://docs.nebius.com/compute/resources/quotas-limits",
                      "https://docs.nebius.com/serverless/jobs/manage",
                      "https://docs.nebius.com/serverless/endpoints/manage"],
        "max_pages": 20}},
      {"id": "synth", "type": "synth-distilabel", "needs": ["research"], "inputs": {
        "pipeline_template": "grounded", "corpus": "${{ nodes.research.outputs.corpus }}",
        "teacher_model": "nvidia/nemotron-3-super-120b-a12b", "n_samples": 300, "max_usd": 0.5, "max_tokens": 800,
        "instructions": "Questions a developer asks while building on Nebius: fine-tuning and deploying models on Token Factory, Serverless AI jobs and endpoints, Object Storage, quotas and prices; answers in at most three sentences, using only the passage, with its exact names, commands and numbers. Where a page lists prices by date, quote the latest (as listed after October 1, 2026), never an older one."}},
      {"id": "prep", "type": "data-prep", "needs": ["synth"], "inputs": {
        "dataset": "${{ nodes.synth.outputs.dataset }}", "format": "chatml", "train_split": 0.8, "test_split": 0.1}},
      {"id": "train", "type": "unsloth-train", "needs": ["prep"], "inputs": {
        "model": "nvidia/Llama-3.1-Nemotron-Nano-8B-v1", "train_data": "${{ nodes.prep.outputs.train_jsonl }}",
        "eval_data": "${{ nodes.prep.outputs.eval_jsonl }}", "lora_alpha": 16, "max_steps": 60, "checkpoint_steps": 30}},
      {"id": "serve", "type": "vllm-serve", "needs": ["train"], "inputs": {
        "model": "nvidia/Llama-3.1-Nemotron-Nano-8B-v1", "lora_adapter": "${{ nodes.train.outputs.lora_adapter }}",
        "keep_alive_min": 25}},
      {"id": "evaluate", "type": "judge-eval", "needs": ["prep", "serve"], "inputs": {
        "test_data": "${{ nodes.prep.outputs.test_jsonl }}",
        "base_model_ref": "${{ nodes.serve.outputs.base_model_ref }}",
        "tuned_model_ref": "${{ nodes.serve.outputs.model_ref }}",
        "judge_model": "nvidia/Nemotron-3-Ultra-550b-a55b", "max_samples": 30}}
    ]
  },
  "reduced_inputs": {
    "research": {"max_pages": 6},
    "synth": {"n_samples": 40, "max_usd": 0.05},
    "train": {"max_steps": 10, "checkpoint_steps": 5},
    "serve": {"keep_alive_min": 10},
    "evaluate": {"max_samples": 5}
  }
}
