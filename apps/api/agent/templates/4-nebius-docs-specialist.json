{
  "slug": "nebius-docs-specialist",
  "title": "Llama 8B tuned as a Nebius docs specialist",
  "intent": "Distill a Nebius docs specialist: fine-tune Llama 3.1 8B on the Nebius AI Cloud and Token Factory docs",
  "rationale": "Tavily extracts 20 Nebius docs pages (Token Factory fine-tuning, models, deploy and billing; AI Cloud Serverless jobs and endpoints, Object Storage, quotas), Nemotron 3 Super writes short Q&A grounded in them, and Token Factory fine-tunes Llama 3.1 8B with LoRA. tf-deploy serves the adapter per token on Token Factory, which is unverified until spike 1; if Token Factory refuses it, serve tf-finetune's lora_adapter with vllm-serve. Nemotron 3 Ultra then judges base against tuned on held-out questions with the source passage as reference, so every answer can be checked against the docs.",
  "plan": {
    "name": "nebius-docs-specialist-llama-8b",
    "nodes": [
      {"id": "research", "type": "web-research", "needs": [], "inputs": {
        "seed_urls": ["https://docs.tokenfactory.nebius.com/post-training/how-to-fine-tune",
                      "https://docs.tokenfactory.nebius.com/post-training/models",
                      "https://docs.nebius.com/serverless/overview",
                      "https://docs.nebius.com/serverless/tutorials/deploy-model",
                      "https://docs.nebius.com/serverless/quickstart/jobs",
                      "https://docs.nebius.com/serverless/pricing-quotas",
                      "https://docs.tokenfactory.nebius.com/post-training/datasets",
                      "https://docs.tokenfactory.nebius.com/ai-models-inference/dedicated-endpoints/custom-weights",
                      "https://docs.tokenfactory.nebius.com/ai-models-inference/dedicated-endpoints/overview",
                      "https://docs.tokenfactory.nebius.com/ai-models-inference/overview",
                      "https://docs.tokenfactory.nebius.com/ai-models-inference/rate-limits",
                      "https://docs.tokenfactory.nebius.com/other-capabilities/billing-new",
                      "https://docs.nebius.com/serverless/jobs/manage",
                      "https://docs.nebius.com/serverless/quickstart/endpoints",
                      "https://docs.nebius.com/serverless/endpoints/manage",
                      "https://docs.nebius.com/serverless/tutorials/fine-tuning",
                      "https://docs.nebius.com/object-storage/overview",
                      "https://docs.nebius.com/object-storage/quickstart",
                      "https://docs.nebius.com/overview/quotas",
                      "https://docs.nebius.com/compute/resources/quotas-limits"],
        "max_pages": 20}},
      {"id": "synth", "type": "synth-distilabel", "needs": ["research"], "inputs": {
        "pipeline_template": "grounded", "corpus": "${{ nodes.research.outputs.corpus }}",
        "teacher_model": "nvidia/nemotron-3-super-120b-a12b", "n_samples": 300, "max_usd": 0.5, "max_tokens": 800,
        "instructions": "Questions a developer asks while building on Nebius: fine-tuning and deploying models on Token Factory, Serverless AI jobs and endpoints, Object Storage, quotas and prices; answers in at most three sentences, using only the passage, with its exact names, commands and numbers."}},
      {"id": "prep", "type": "data-prep", "needs": ["synth"], "inputs": {
        "dataset": "${{ nodes.synth.outputs.dataset }}", "format": "chatml", "train_split": 0.8, "test_split": 0.1}},
      {"id": "finetune", "type": "tf-finetune", "needs": ["prep"], "inputs": {
        "model": "meta-llama/Llama-3.1-8B-Instruct", "train_data": "${{ nodes.prep.outputs.train_jsonl }}",
        "eval_data": "${{ nodes.prep.outputs.eval_jsonl }}", "n_epochs": 2}},
      {"id": "deploy", "type": "tf-deploy", "needs": ["finetune"], "inputs": {
        "job": "${{ nodes.finetune.outputs.job }}"}},
      {"id": "evaluate", "type": "judge-eval", "needs": ["prep", "deploy"], "inputs": {
        "test_data": "${{ nodes.prep.outputs.test_jsonl }}",
        "base_model_ref": "meta-llama/Llama-3.1-8B-Instruct",
        "tuned_model_ref": "${{ nodes.deploy.outputs.model_ref }}",
        "judge_model": "nvidia/Nemotron-3-Ultra-550b-a55b", "max_samples": 30}}
    ]
  },
  "reduced_inputs": {
    "research": {"max_pages": 6},
    "synth": {"n_samples": 40, "max_usd": 0.05},
    "finetune": {"n_epochs": 1},
    "evaluate": {"max_samples": 5}
  }
}
